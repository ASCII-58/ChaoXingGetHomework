{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "xxt",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "xxt",
        "width": 1100,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob: https: http:"
    }
  }
}
